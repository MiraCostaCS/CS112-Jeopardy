<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="220.0" prefWidth="600.0" spacing="15.0" style="-fx-background-color: #7dc9ec;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jeopardy.controller.QuestionController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="questionLabel" alignment="CENTER" style="-fx-font-family: 'Arial'; -fx-font-weight: bold; -fx-font-size: 32px; -fx-text-fill: WHITE;" text="Question Text" wrapText="true">
         </Label>
      <TextField fx:id="answerInput" maxWidth="300.0" promptText="Type your answer here..." />
      <Button onAction="#handleSubmit" style="-fx-background-color: #96c45c; -fx-text-fill: black; -fx-font-weight: bold;" text="Submit Answer" />
   </children>
</VBox>
