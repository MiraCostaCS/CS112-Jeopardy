<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane style="-fx-background-color: #7dc9ec;"
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.jeopardy.controller.MainController">
   <top>
      <HBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label style="-fx-font-family: 'Impact'; -fx-font-size: 36px; -fx-text-fill: #154670;" text="WARMUP GAME!" />
            <Label fx:id="scoreLabel" style="-fx-font-family: 'Arial'; -fx-font-weight: bold; -fx-font-size: 22px; -fx-text-fill: WHITE;" text="Score: $0" />
            <Button onAction="#handleLoadCSV" style="-fx-background-color: #96c45c; -fx-text-fill: black; -fx-font-weight: bold;" text="Load CSV File" />
         </children>
      </HBox>
   </top>
   <center>
      <GridPane fx:id="boardGrid" alignment="CENTER" hgap="10.0" vgap="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </GridPane>
   </center>
</BorderPane>
