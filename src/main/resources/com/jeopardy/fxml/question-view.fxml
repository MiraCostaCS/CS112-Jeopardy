<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="220.0" prefWidth="450.0" spacing="15.0" 
      style="-fx-background-color: #000B5D;" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.jeopardy.controller.QuestionController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="questionLabel" alignment="CENTER" style="-fx-font-family: 'Arial'; -fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: WHITE;" text="Question Text" wrapText="true" />
      <TextField fx:id="answerInput" maxWidth="300.0" promptText="Type your answer here..." />
      <Button onAction="#handleSubmit" style="-fx-background-color: #D6A800; -fx-text-fill: black; -fx-font-weight: bold;" text="Submit Answer" />
   </children>
</VBox>
